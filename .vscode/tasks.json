{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "实验三：决策表测试（默认生成任务）",
      "type": "shell",
      "command": "python",
      "args": ["decision_table_runner.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "实验三：单条用例",
      "type": "shell",
      "command": "python",
      "args": ["decision_table_runner.py", "--case", "${input:caseId}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "clear": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "实验二：等价类测试",
      "type": "shell",
      "command": "python",
      "args": ["equivalence_test_runner.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "clear": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "实验一：回归测试",
      "type": "shell",
      "command": "python",
      "args": ["run_tests.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "clear": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "生成 Excel 用例表",
      "type": "shell",
      "command": "python",
      "args": ["scripts\\build_decision_table_workbook.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "clear": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "caseId",
      "type": "promptString",
      "description": "决策表用例编号（DT-01 ~ DT-12）",
      "default": "DT-01"
    }
  ]
}
