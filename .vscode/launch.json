{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "实验三：决策表全部用例",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/decision_table_runner.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "实验三：单条用例（可改 DT 编号）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/decision_table_runner.py",
      "args": ["--case", "DT-01"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "实验二：等价类测试",
